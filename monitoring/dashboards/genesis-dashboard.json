{
  "title": "Genesis-dashboard",
  "tags": ["gaming-stats", "prometheus"],
  "timezone": "browser",
  "panels": [
    {
      "id": 1,
      "title": "Request Rate",
      "targets": [
        {
          "expr": "sum by (status_code) (rate(http_requests_total[5m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Error Rate",
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{status_code=~\"5..\"}[5m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Latency p95",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket[5m])))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "CPU Usage",
      "targets": [
        {
          "expr": "sum(rate(container_cpu_usage_seconds_total{pod=~\"genesis-deployment.*\"}[5m])) * 100",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Memory Usage",
      "targets": [
        {
          "expr": "sum(container_memory_working_set_bytes{pod=~\"genesis-deployment.*\"}) / 1024 / 1024",
          "refId": "A"
        }
      ]
    }
  ]
}
